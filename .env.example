# ── Twilio ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# ── Google Sheets ───────────────────────────────────
# Base64-encoded contents of your Google service account JSON key file.
# Generate with: base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here
# The ID of the delivery spreadsheet (for DLVR date tabs):
DELIVERY_SHEET_ID=your_delivery_spreadsheet_id_here
# Optional: route-specific spreadsheets. When set, orders for that route are
# written directly to the "Restaurant_Data" tab on the sheet, updating the row
# whose column A matches the restaurant name (columns B=Date, C-I=products).
SHEET_ID_25252=
SHEET_ID_25248=

# ── SendGrid ────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=orders@yourbusiness.com
WAREHOUSE_EMAIL=warehouse@yourbusiness.com,you@youremail.com

# ── OpenAI (optional, for AI-assisted order parsing) ─
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Application ─────────────────────────────────────
PORT=3000
# Timezone for cron schedules
TZ=America/New_York
LOG_LEVEL=info
# Set to "true" to enable the automated SMS/email scheduler.
# Defaults to false — the service will run but won't send anything
# until you flip this to true.
SCHEDULER_ENABLED=false
# Optional: set a phone number for test mode. When set, the scheduler
# will ONLY send SMS to this number instead of all customers.
# Remove or leave blank to send to everyone.
TEST_PHONE_NUMBER=

# Optional: your personal phone number. When set, every SMS exchange
# (inbound customer messages + outbound bot replies) is forwarded to
# this number so you can follow along in real-time.
ADMIN_PHONE_NUMBER=

# ── Products ────────────────────────────────────────
# Comma-separated list of products you sell.
# These are used in the outbound SMS prompt and order parsing.
PRODUCTS=chicken,ribs,pulled_pork,brisket,coleslaw,beans
